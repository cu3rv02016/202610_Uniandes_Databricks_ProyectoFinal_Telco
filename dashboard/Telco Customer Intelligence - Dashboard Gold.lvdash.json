    {
      "name": "7990bb22",
      "displayName": "ds_clientes_gold",
      "queryLines": [
        "SELECT *\r\n",
        "FROM workspace.telco_gold.kpi_clientes_ciudad_segmento;"
      ]
    },
    {
      "name": "227ad39b",
      "displayName": "ds_porcentaje_activos",
      "queryLines": [
        "SELECT\r\n",
        "    ROUND(\r\n",
        "        100.0 * SUM(clientes_activos)\r\n",
        "        / NULLIF(SUM(total_clientes), 0),\r\n",
        "        1\r\n",
        "    ) AS porcentaje_activos\r\n",
        "FROM workspace.telco_gold.kpi_clientes_ciudad_segmento;"
      ]
    },
    {
      "name": "d5b38ae2",
      "displayName": "ds_altas_mensuales",
      "queryLines": [
        "SELECT\r\n",
        "    mes_alta,\r\n",
        "    SUM(total_altas) AS altas_mes\r\n",
        "FROM workspace.telco_gold.kpi_altas_mensuales\r\n",
        "GROUP BY mes_alta;"
      ]
    }
  ],
